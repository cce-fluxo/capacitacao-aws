# Copie para .env (cp .env.example .env) e preencha durante a aula.
# Tudo é opcional: sem DATABASE_URL e sem S3_BUCKET a app sobe normalmente.

# Região da AWS (usada pelo S3), ex.: us-east-1
AWS_REGION=us-east-1

# Porta da API (o Nginx faz proxy para ela)
PORT=3000

# Banco (RDS Postgres). Sem esta linha o cartão "Banco" fica apagado.
# Não use ?sslmode=... aqui: o SSL já é ligado no código.
# DATABASE_URL=postgresql://postgres:SENHA@ENDPOINT:5432/postgres

# Bucket S3 (o nome deve começar com capacitacao-aws-). Sem esta linha o cartão "Arquivos" fica apagado.
# S3_BUCKET=capacitacao-aws-SEUNOME

# Só para teste local com docker-compose: desliga o SSL do Postgres
# DB_SSL=false
